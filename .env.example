# Database configuration (Defaults to local SQLite for instant zero-config evaluation; supports PostgreSQL via postgresql://...)
DATABASE_URL="file:./dev.db"

# Python ML Model Service URL
PYTHON_ML_SERVICE_URL="http://127.0.0.1:8000"

# AI Agent Configuration
LLM_PROVIDER="gemini"
LLM_API_KEY="your_gemini_or_openai_api_key_here"

# Razorpay API Sandbox Credentials (Simulated / Sandbox)
RAZORPAY_KEY_ID="rzp_test_sample_key_id"
RAZORPAY_KEY_SECRET="sample_key_secret"

# Demo Mode Settings
NEXT_PUBLIC_DEMO_MERCHANT="Nova Apparel"
NEXT_PUBLIC_APP_ENV="development"
